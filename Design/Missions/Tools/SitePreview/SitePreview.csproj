<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws generated mission sites to PNGs outside the game, from the mod's own generator code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Missions\Util\SiteGen\*.cs" Link="SiteGen\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
